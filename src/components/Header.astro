---
import { SITE, NAV } from '../consts';

const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="sticky top-0 z-50 bg-neutral-950/80 backdrop-blur border-b border-neutral-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-semibold text-base sm:text-lg group">
      <span class="text-accent-500 group-hover:rotate-12 transition">✦</span>
      <span class="text-neutral-100">{SITE.title}</span>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-sm">
      {NAV.map((item) => (
        <a
          href={item.href}
          class={`transition hover:text-accent-400 ${
            isActive(item.href) ? 'text-accent-400 font-medium' : 'text-neutral-300'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`mailto:${SITE.email}`}
        class="hidden sm:inline text-sm text-neutral-500 hover:text-neutral-200 transition"
      >
        📧
      </a>
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-neutral-300"
        aria-label="菜单"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-800 bg-neutral-950">
    <nav class="px-4 py-3 flex flex-col gap-1">
      {NAV.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-2 rounded-lg text-sm ${
            isActive(item.href) ? 'bg-accent-500/10 text-accent-400' : 'text-neutral-300 hover:bg-neutral-900'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
