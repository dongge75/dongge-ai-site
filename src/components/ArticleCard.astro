---
interface Props {
  title: string;
  desc: string;
  date?: string;
  source?: string;
  href: string;
}

const {
  title,
  desc,
  source = '公众号',
  href,
  date = '待补充',
} = Astro.props;
---

<a
  href={href}
  class="block rounded-xl border border-neutral-800 bg-neutral-900 p-5 hover:border-accent-500/60 hover:bg-neutral-800/60 transition"
>
  <span class="text-xs px-2 py-0.5 rounded bg-accent-500/15 text-accent-300 font-medium">
    {source}
  </span>
  <h3 class="mt-3 font-medium text-neutral-100 leading-snug">{title}</h3>
  <p class="mt-2 text-sm text-neutral-400 line-clamp-2 leading-relaxed">{desc}</p>
  <div class="mt-3 text-xs text-neutral-500">{date}</div>
</a>
