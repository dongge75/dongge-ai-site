---
interface Props {
  title: string;
  desc: string;
  date?: string;
  source?: string;
  href: string;
}

const {
  title,
  desc,
  source = '公众号',
  href,
  date = '待补充',
} = Astro.props;
---

<a
  href={href}
  class="card-hover block rounded-xl border border-[#222222] bg-transparent p-5"
>
  <span class="text-xs px-2 py-0.5 rounded border border-accent-30-alpha text-accent-400 font-medium">
    {source}
  </span>
  <h3 class="mt-3 font-medium text-white leading-snug">{title}</h3>
  <p class="mt-2 text-sm text-[#9ca3af] line-clamp-2 leading-relaxed">{desc}</p>
  <div class="mt-3 text-xs text-[#6b7280]">{date}</div>
</a>
