---
interface Props {
  href: string;
  url: string;
  tag: string;
  title: string;
  desc: string;
  cta: string;
  icon: string;
  screenshotNote: string;
  gradient: 'amber' | 'blue' | 'rose' | 'green' | 'purple';
}

const {
  href,
  url,
  tag,
  title,
  desc,
  cta,
  icon,
  screenshotNote,
  gradient,
} = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group block h-full"
>
  <div
    class="rounded-2xl overflow-hidden ring-1 ring-neutral-800 shadow-xl shadow-black/30 transition group-hover:-translate-y-1 group-hover:shadow-2xl group-hover:shadow-accent-500/20 bg-white h-full flex flex-col"
    class:list={[
      gradient === 'amber' && 'group-hover:ring-amber-400',
      gradient === 'blue' && 'group-hover:ring-blue-400',
      gradient === 'rose' && 'group-hover:ring-rose-400',
      gradient === 'green' && 'group-hover:ring-green-400',
      gradient === 'purple' && 'group-hover:ring-purple-400',
    ]}
  >
    <!-- 浏览器外壳 -->
    <div class="bg-neutral-100 px-3 py-2.5 flex items-center gap-2 border-b border-neutral-200">
      <div class="flex gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-green-400/80"></span>
      </div>
      <div class="flex-1 px-2 py-1 bg-white rounded-md text-[11px] text-neutral-500 truncate font-mono flex items-center gap-1">
        <span>🔒</span>
        <span class="truncate">{url}</span>
      </div>
      <span class="text-neutral-400 text-xs">↗</span>
    </div>

    <!-- 截图占位 · aspect-[2/1] 把窗口缩到 50% 高度 + 主色渐变 -->
    <div
      class="aspect-[2/1] relative overflow-hidden flex items-center justify-center"
      class:list={[
        gradient === 'amber' && 'bg-gradient-to-br from-amber-100 via-orange-100 to-pink-100',
        gradient === 'blue' && 'bg-gradient-to-br from-blue-100 via-cyan-100 to-teal-100',
        gradient === 'rose' && 'bg-gradient-to-br from-rose-100 via-pink-100 to-fuchsia-100',
        gradient === 'green' && 'bg-gradient-to-br from-green-100 via-emerald-100 to-teal-100',
        gradient === 'purple' && 'bg-gradient-to-br from-purple-100 via-violet-100 to-fuchsia-100',
      ]}
    >
      <!-- 装饰光晕 · 缩到 60% -->
      <div class="absolute -top-6 -right-6 w-20 h-20 rounded-full bg-white/40 blur-2xl"></div>
      <div class="text-center px-4 relative">
        <div class="text-5xl mb-2 drop-shadow-sm">{icon}</div>
        <div class="text-sm text-neutral-700 font-mono font-medium">{screenshotNote}</div>
        <div class="text-[10px] text-neutral-500/80 mt-2 leading-relaxed">
          截图请放进<br />
          <code class="bg-white/60 px-1.5 py-0.5 rounded text-[10px]">public/images/</code>
        </div>
      </div>
    </div>

    <!-- 标题 + CTA -->
    <div
      class="p-5 border-t flex-1 flex flex-col"
      class:list={[
        gradient === 'amber' && 'bg-amber-50 border-amber-200',
        gradient === 'blue' && 'bg-blue-50 border-blue-200',
        gradient === 'rose' && 'bg-rose-50 border-rose-200',
        gradient === 'green' && 'bg-green-50 border-green-200',
        gradient === 'purple' && 'bg-purple-50 border-purple-200',
      ]}
    >
      <div
        class="text-xs font-bold uppercase tracking-wider mb-2"
        class:list={[
          gradient === 'amber' && 'text-amber-700',
          gradient === 'blue' && 'text-blue-700',
          gradient === 'rose' && 'text-rose-700',
          gradient === 'green' && 'text-green-700',
          gradient === 'purple' && 'text-purple-700',
        ]}
      >
        {tag}
      </div>
      <h3 class="text-xl font-bold text-neutral-900 leading-tight">{title}</h3>
      <p class="mt-2 text-sm text-neutral-600 line-clamp-2 leading-relaxed flex-1">{desc}</p>
      <div
        class="mt-4 inline-flex items-center gap-1 text-sm font-semibold group-hover:translate-x-1 transition"
        class:list={[
          gradient === 'amber' && 'text-amber-700',
          gradient === 'blue' && 'text-blue-700',
          gradient === 'rose' && 'text-rose-700',
          gradient === 'green' && 'text-green-700',
          gradient === 'purple' && 'text-purple-700',
        ]}
      >
        {cta} →
      </div>
    </div>
  </div>
</a>
