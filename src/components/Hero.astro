---
import { SITE } from '../consts';
import Button from './Button.astro';
---

<section class="relative overflow-hidden">
  <!-- 装饰性背景：极淡薄荷绿 -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(112,255,195,0.06),_transparent_60%)] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-10 md:pt-12 md:pb-14 text-center">
    <div class="inline-block mb-3 px-3 py-1 text-xs rounded-full text-accent-400 border border-accent-30-alpha">
      ✨ AI 实战派 · 个人平台
    </div>

    <h1 class="text-5xl md:text-7xl font-heading font-extrabold tracking-tight text-white leading-tight">
      Hi，我是 <span class="text-accent-400">东歌</span> ✨
    </h1>

    <p class="mt-4 text-xl md:text-2xl text-[#9ca3af] max-w-3xl mx-auto leading-relaxed font-light">
      {SITE.tagline}
    </p>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="#platforms" variant="primary" size="md">
        进入平台 →
      </Button>
      <Button href="/about/" variant="secondary" size="md">
        关注公众号
      </Button>
    </div>

    <p class="mt-8 text-sm text-[#6b7280]">↓ 向下滚动探索</p>
  </div>
</section>
