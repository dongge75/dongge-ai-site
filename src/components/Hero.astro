---
import { SITE } from '../consts';
import Button from './Button.astro';
---

<section class="relative overflow-hidden">
  <!-- 装饰性背景 -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-accent-900/20 via-transparent to-transparent pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-10 md:pt-12 md:pb-14 text-center">
    <div class="inline-block mb-3 px-3 py-1 text-xs rounded-full bg-accent-500/10 text-accent-300 border border-accent-500/30">
      ✨ AI 实战派 · 个人平台
    </div>

    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white leading-tight">
      Hi，我是 <span class="bg-gradient-to-r from-accent-400 to-orange-400 bg-clip-text text-transparent">东歌</span> ✨
    </h1>

    <p class="mt-3 text-xl md:text-2xl text-neutral-300 max-w-3xl mx-auto leading-relaxed font-light">
      {SITE.tagline}
    </p>

    <div class="mt-5 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="#platforms" variant="primary" size="md">
        进入平台 →
      </Button>
      <Button href="#community" variant="secondary" size="md">
        关注公众号
      </Button>
    </div>

    <p class="mt-8 text-sm text-neutral-500">↓ 向下滚动探索</p>
  </div>
</section>
