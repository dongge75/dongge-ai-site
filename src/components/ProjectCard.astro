---
interface Props {
  title: string;
  desc: string;
  tag?: string;
  href?: string;
}

const { title, desc, tag, href } = Astro.props;
const clickable = href && href !== '#';
---

{clickable ? (
  <a
    href={href}
    class="card-hover group block rounded-xl border border-[#222222] bg-transparent p-6"
  >
    <div class="flex items-center gap-2 mb-3 flex-wrap">
      <h3 class="font-semibold text-white group-hover:text-accent-400 transition">
        {title}
      </h3>
      {tag && (
        <span class="text-xs px-2 py-0.5 rounded border border-accent-30-alpha text-accent-400">
          {tag}
        </span>
      )}
    </div>
    <p class="text-sm text-[#9ca3af] leading-relaxed">{desc}</p>
    <div class="mt-4 text-sm text-accent-400 opacity-70 md:opacity-0 md:group-hover:opacity-100 transition">
      ▸ 查看
    </div>
  </a>
) : (
  <div class="block rounded-xl border border-dashed border-[#343434] bg-transparent p-6">
    <div class="flex items-center gap-2 mb-3 flex-wrap">
      <h3 class="font-semibold text-[#6b7280]">{title}</h3>
      {tag && (
        <span class="text-xs px-2 py-0.5 rounded bg-[#151515] text-[#6b7280]">
          {tag}
        </span>
      )}
    </div>
    <p class="text-sm text-[#6b7280] leading-relaxed">{desc}</p>
  </div>
)}
