---
interface Props {
  title: string;
  desc: string;
  href: string;
  emoji: string;
  ready?: boolean;
}

const { title, desc, href, emoji, ready = true } = Astro.props;
---

{ready ? (
  <a
    href={href}
    class="group relative block rounded-xl border border-neutral-800 bg-neutral-900 p-6 transition hover:border-accent-500/60 hover:bg-neutral-800/60 hover:shadow-lg hover:shadow-accent-500/10"
  >
    <div class="text-3xl mb-3">{emoji}</div>
    <h3 class="font-semibold text-neutral-100 group-hover:text-accent-400 transition">
      {title}
    </h3>
    <p class="mt-1 text-sm text-neutral-400 leading-relaxed">{desc}</p>
    <div class="mt-4 text-sm text-accent-400 opacity-70 md:opacity-0 md:group-hover:opacity-100 transition">
      ▸ 打开
    </div>
  </a>
) : (
  <div
    class="relative block rounded-xl border border-dashed border-neutral-800 bg-neutral-900/40 p-6"
    title="该工具尚未上线"
  >
    <div class="text-3xl mb-3 opacity-60">{emoji}</div>
    <h3 class="font-semibold text-neutral-500">{title}</h3>
    <p class="mt-1 text-sm text-neutral-600 leading-relaxed">{desc}</p>
    <span class="absolute top-3 right-3 text-xs px-2 py-0.5 bg-neutral-800 text-neutral-500 rounded">
      敬请期待
    </span>
  </div>
)}
