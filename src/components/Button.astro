---
// 统一按钮组件 · 全站只用这一个，避免散落的 inline class
// 用法：<Button href="..." variant="primary" size="md">点击</Button>
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className = '',
  ariaLabel,
  ...rest
} = Astro.props;

const baseClass = 'inline-flex items-center gap-2 rounded-[10px] font-bold transition whitespace-nowrap min-h-[52px]';

const variantClass: Record<string, string> = {
  primary:
    'bg-transparent border border-white text-white hover:bg-white hover:text-[#0a0a0a]',
  accent:
    'bg-accent-500 border border-accent-500 text-[#0a0a0a] hover:bg-accent-400',
  secondary:
    'bg-transparent border border-[#343434] text-white hover:border-[#70ffc380]',
  ghost: 'text-accent-400 hover:underline px-0 min-h-0',
};

const sizeClass: Record<string, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};

const Tag = href ? 'a' : 'button';
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag
  href={href}
  class:list={[baseClass, variantClass[variant], sizeClass[size], className]}
  aria-label={ariaLabel}
  {...externalAttrs}
  {...rest}
>
  <slot />
</Tag>
