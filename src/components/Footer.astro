---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="mt-5 border-t border-[#222222]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 text-sm text-[#9ca3af]">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <p class="font-medium text-white">© {year} {SITE.title} · {SITE.tagline}</p>
      <div class="flex flex-row items-center gap-6">
        <a href={`mailto:${SITE.email}`} class="hover:text-accent-400 transition">
          📧 {SITE.emailDisplay}
        </a>
        <a href="/rss.xml" class="hover:text-accent-400 transition">RSS</a>
        <div class="flex flex-col items-center gap-1">
          <div class="w-20 h-20 rounded-md border border-[#222222] bg-white p-1">
            <img
              src="/images/wechat-qrcode.webp"
              alt="微信二维码"
              width="80"
              height="80"
              loading="lazy"
              class="w-full h-full block"
            />
          </div>
          <span class="text-[10px] text-[#6b7280]">扫码加微信</span>
        </div>
      </div>
    </div>
  </div>
</footer>
