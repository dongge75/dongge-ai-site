---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-neutral-800 bg-neutral-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 text-sm text-neutral-400">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div>
        <p class="font-medium text-neutral-200">© {year} {SITE.title} · 东歌</p>
        <p class="mt-1 text-neutral-500">{SITE.tagline}</p>
      </div>
      <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6">
        <a href={`mailto:${SITE.email}`} class="hover:text-accent-400 transition">
          📧 {SITE.emailDisplay}
        </a>
        <span>公众号：{SITE.wechatOAName}</span>
        <a href="/rss.xml" class="hover:text-accent-400 transition">RSS</a>
      </div>
    </div>
    <p class="mt-8 text-xs text-neutral-600">
      {SITE.icp ? `备案号：${SITE.icp} · ` : ''}Built with Astro · 本站由 东歌 维护
    </p>
  </div>
</footer>
