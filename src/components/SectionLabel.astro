---
interface Props {
  number: string;
  title: string;
  englishLabel?: string;
}

const { number, title, englishLabel } = Astro.props;
---

<div class="flex items-baseline gap-3 mb-1.5">
  <span class="text-sm font-mono font-bold text-accent-400">{number}</span>
  {englishLabel && (
    <span class="text-xs font-bold text-accent-400 uppercase tracking-wider">{englishLabel}</span>
  )}
  <span class="text-xs text-[#343434]">▌</span>
</div>
<h2 class="text-2xl md:text-3xl font-heading font-extrabold text-white">{title}</h2>
