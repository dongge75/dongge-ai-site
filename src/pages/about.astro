---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../consts';

const timeline = [
  { year: '2026', item: '做现在的项目：东歌AI 个人平台 + 两个 AI 平台入口' },
  { year: '2025', item: `开始做公众号「${SITE.wechatOAName}」` },
];

const doingNow = [
  '维护「' + SITE.wechatOAName + '」公众号，记录 AI 工具实战',
  '运营 aishopdg.quantv.com —— AI 购物平台',
  '做 1-2 个面向电商商家的 AI 小工具',
];
---

<BaseLayout title="关于我" description={`关于 ${SITE.author}：${SITE.tagline}`}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <a href="/" class="text-sm text-accent-400 hover:underline">◀ 回到首页</a>

    <header class="mt-4 flex items-start gap-6">
      <div
        class="w-24 h-24 rounded-full bg-gradient-to-br from-accent-400 to-orange-500 flex-shrink-0 flex items-center justify-center text-3xl text-neutral-950 font-bold shadow-lg shadow-accent-500/30"
      >
        东
      </div>
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-white">你好，我是 东歌</h1>
        <p class="mt-2 text-lg text-neutral-300 leading-relaxed">
          {SITE.tagline}
        </p>
        <p class="mt-2 text-neutral-300 leading-relaxed">
          我做审计 10 多年，副业紧跟AI实操落地，最近 1年搭了 AI 电商全链路创作平台、跑通视频号AI图书带货、AI 公众号写作、AI工具编程等。没人带容易绕弯路，我把走通的路整理在这里，希望帮你少走点弯路和闭坑。
        </p>
      </div>
    </header>

    <section class="mt-8">
      <h2 class="text-xl font-semibold mb-2 text-white">现在在做的事</h2>
      <ul class="space-y-1 text-neutral-300">
        {doingNow.map((d) => <li>· {d}</li>)}
      </ul>
    </section>

    <section class="mt-6">
      <h2 class="text-xl font-semibold mb-2 text-white">时间线</h2>
      <ol class="border-l-2 border-neutral-800 pl-6 space-y-3">
        {timeline.map((t) => (
          <li>
            <div class="text-sm text-accent-400 font-mono font-semibold">{t.year}</div>
            <div class="font-medium mt-1 text-neutral-100">{t.item}</div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mt-6">
      <h2 class="text-xl font-semibold mb-2 text-white">联系</h2>
      <ul class="space-y-1 text-neutral-300">
        <li>📧 <a href={`mailto:${SITE.email}`} class="text-accent-400 hover:underline">{SITE.email}</a></li>
        <li>💬 微信公众号：{SITE.wechatOAName}</li>
        <li>🛒 AI 购物平台：<a href="https://aishopdg.quantv.com/" target="_blank" rel="noopener" class="text-accent-400 hover:underline">aishopdg.quantv.com</a></li>
      </ul>

      <div class="mt-4">
        <Button href="/" variant="secondary" size="md">
          ◀ 回到首页
        </Button>
      </div>
    </section>
  </article>
</BaseLayout>
