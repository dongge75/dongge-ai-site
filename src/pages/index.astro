---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ToolCard from '../components/ToolCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PlatformCard from '../components/PlatformCard.astro';
import Button from '../components/Button.astro';
import { SITE } from '../consts';

const projects = [
  {
    title: '东歌智能客服',
    desc: '面向淘宝/拼多多商家的 AI 自动回复工具，减少 80% 客服人力',
    tag: 'AI Agent',
    emoji: '🤖',
    href: '/projects/',
  },
  {
    title: '东歌选品助手',
    desc: '基于历史销量数据，智能推荐下一个潜在爆款商品',
    tag: '电商',
    emoji: '📊',
    href: '/projects/',
  },
  {
    title: '东歌 AI 副业笔记',
    desc: '记录我用 AI 工具做副业的全过程与方法论',
    tag: '知识库',
    emoji: '📝',
    href: '/blog/',
  },
];

const articles = [
  {
    title: '从 0 到 1：搭建个人一站式平台',
    desc: '把公众号、视频号、自研工具统一到一个入口。这一篇讲架构和坑...',
    date: '2026-10-12',
    source: '博客',
    href: '/blog/',
  },
  {
    title: '用 AI 重构客服工作流：从每日 200 条消息到解放双手',
    desc: '一年前我每天要回复上百条相似的问题，直到用 AI 把它们全部交给 Agent...',
    date: '2026-10-08',
    source: '公众号',
    href: '/blog/',
  },
  {
    title: 'OPC 创业者必备的 5 个 AI 工具',
    desc: '一个人 = 一家公司。这些 AI 工具让你事半功倍，把繁琐的事交给模型...',
    date: '2026-09-25',
    source: '公众号',
    href: '/blog/',
  },
];

const tools = [
  {
    title: 'MD 转公众号',
    desc: '粘贴 Markdown，一键复制公众号富文本',
    emoji: '📝',
    href: '/tools/md2wechat/',
    ready: true,
  },
  {
    title: '封面图生成',
    desc: '标题 + 模板，一键导出公众号封面 PNG',
    emoji: '🎨',
    href: '/tools/cover/',
    ready: false,
  },
  {
    title: '配色卡生成',
    desc: '输入主色，导出 5 色调色板（CSS / JSON）',
    emoji: '🎨',
    href: '/tools/palette/',
    ready: false,
  },
];

const platforms = [
  {
    href: 'https://aishopdg.quantv.com/',
    url: 'aishopdg.quantv.com',
    tag: '电商 + 自媒体 AI',
    title: 'AI 电商与创作平台',
    desc: '一个平台同时跑通电商 + 自媒体：无限画布、智能体、爆款复刻、公众号/小红书/抖音一键发布。',
    cta: '立即体验',
    icon: '🛒',
    gradient: 'green' as const,
  },
  {
    href: '/recommend/paiju/',
    url: 'donggeai.com/recommend/paiju',
    tag: 'AI 实用工具社群',
    title: 'AI 实用工具社群',
    desc: '东哥1 邀请入口 · 7 天免费体验 + 3 天新手实操课。',
    cta: '立即加入',
    icon: '🚀',
    gradient: 'green' as const,
  },
];
---

<BaseLayout>
  <Hero />

  <!-- 01 平台入口 — 最重要 -->
  <section id="platforms" class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <SectionLabel number="01" title="平台入口" />
    <p class="text-neutral-400 -mt-6 mb-5 text-sm max-w-xl">
      两个我亲自在做的项目。从这里进去，就是对应的官方页面。
    </p>
    <div class="grid md:grid-cols-2 gap-3">
      {platforms.map((p) => (
        <PlatformCard
          href={p.href}
          url={p.url}
          tag={p.tag}
          title={p.title}
          desc={p.desc}
          cta={p.cta}
          icon={p.icon}
          gradient={p.gradient}
        />
      ))}
    </div>
  </section>

  <!-- 02 我在用的 AI 工具 -->
  <section id="toolkit" class="bg-neutral-900/50 border-y border-neutral-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <SectionLabel number="02" title="我目前在用的 AI 工具" />
      <p class="text-neutral-400 -mt-6 mb-5 text-sm max-w-xl">
        51 岁，审计人。这 4 类工具是我每天在用的组合，<strong class="text-accent-400">每类都能展开成一篇教程</strong>。
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4 hover:border-accent-500 transition group">
          <div class="text-3xl mb-3">💻</div>
          <div class="text-xs text-accent-400 font-semibold tracking-wider mb-1">写代码</div>
          <h3 class="text-lg font-semibold text-white">Claude Code / Codex / WorkBuddy</h3>
          <p class="mt-2 text-sm text-neutral-400 leading-relaxed">写审计过程小工具：底稿生成、抽样脚本、Excel 自动化、报告模板。51 岁也能写代码，关键是 AI 帮我跨过语法门槛。</p>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4 hover:border-accent-500 transition group">
          <div class="text-3xl mb-3">📝</div>
          <div class="text-xs text-accent-400 font-semibold tracking-wider mb-1">写文案</div>
          <h3 class="text-lg font-semibold text-white">ChatGPT / Claude Code</h3>
          <p class="mt-2 text-sm text-neutral-400 leading-relaxed">拆解对标公众号 / 小红书 / X 文案，提炼结构、金句、情绪节奏。我公众号 100+ 篇的选题初稿都从这里来。</p>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4 hover:border-accent-500 transition group">
          <div class="text-3xl mb-3">📚</div>
          <div class="text-xs text-accent-400 font-semibold tracking-wider mb-1">做带货</div>
          <h3 class="text-lg font-semibold text-white">ChatGPT / WorkBuddy</h3>
          <p class="mt-2 text-sm text-neutral-400 leading-relaxed">视频号图书带货：选品分析、口播稿、剪辑、发布、数据复盘。AI 让我一个人就是一个带货团队。</p>
        </div>
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4 hover:border-accent-500 transition group">
          <div class="text-3xl mb-3">📖</div>
          <div class="text-xs text-accent-400 font-semibold tracking-wider mb-1">写公众号</div>
          <h3 class="text-lg font-semibold text-white">Obsidian / 飞书 / Claude Code</h3>
          <p class="mt-2 text-sm text-neutral-400 leading-relaxed">100+ 篇原创：选题、写作、润色、排版、发布全流程。Obsidian 管知识库，飞书管协作，Claude Code 管润色。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 用 CLI 赚钱 · 东歌1 个人实战 -->
  <section id="cli-money" class="bg-gradient-to-br from-accent-500/10 via-neutral-900/50 to-orange-500/5 border-y border-accent-500/30">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <SectionLabel number="03" title="用 CLI 赚钱 · 3 个真实场景" />
      <p class="text-neutral-300 -mt-6 mb-5 text-sm max-w-2xl">
        51 岁审计人。这是我过去 30 天用<strong class="text-accent-400">破局 CLI</strong>跑的 3 个真实工作流，每个都直接转化为收入。
      </p>

      <div class="grid md:grid-cols-3 gap-3">
        <!-- 卡片 1 · 公众号 -->
        <div class="relative rounded-xl border border-accent-500/40 bg-neutral-900 p-4 hover:border-accent-400 transition group overflow-hidden">
          <div class="absolute top-3 right-3 text-[10px] font-bold text-accent-400 bg-accent-500/10 px-2 py-1 rounded uppercase tracking-wider">每天 1 小时</div>
          <div class="text-3xl mb-3">📝</div>
          <div class="text-xs text-accent-400 font-semibold tracking-wider mb-1">公众号 · 选题 / 摘要</div>
          <h3 class="text-lg font-semibold text-white">100+ 篇选题不焦虑</h3>
          <p class="mt-3 text-sm text-neutral-400 leading-relaxed">
            <strong class="text-white">之前</strong>：每天手动读 5 篇精华帖，1 小时才出 1 个选题。
          </p>
          <p class="mt-2 text-sm text-neutral-400 leading-relaxed">
            <strong class="text-accent-400">用 CLI</strong>：抓 30 篇精华帖 → 5 个候选选题 + 摘要初稿，10 分钟搞定。
          </p>
          <p class="mt-3 text-sm font-semibold text-orange-400">→ 收入：流量主 + 带货分成</p>
        </div>

        <!-- 卡片 2 · 视频号带货 -->
        <div class="relative rounded-xl border border-accent-500/40 bg-neutral-900 p-4 hover:border-accent-400 transition group overflow-hidden">
          <div class="absolute top-3 right-3 text-[10px] font-bold text-accent-400 bg-accent-500/10 px-2 py-1 rounded uppercase tracking-wider">每周 5 小时</div>
          <div class="text-3xl mb-3">📚</div>
          <div class="text-xs text-accent-400 font-semibold tracking-wider mb-1">视频号 · 图书带货</div>
          <h3 class="text-lg font-semibold text-white">1 人 = 1 个带货团队</h3>
          <p class="mt-3 text-sm text-neutral-400 leading-relaxed">
            <strong class="text-white">之前</strong>：每条口播稿 30 分钟，选品靠刷抖店。
          </p>
          <p class="mt-2 text-sm text-neutral-400 leading-relaxed">
            <strong class="text-accent-400">用 CLI</strong>：抓同类爆款脚本 → 5 版口播稿，5 分钟选稿；选品分析 5 分钟出报告。
          </p>
          <p class="mt-3 text-sm font-semibold text-orange-400">→ 收入：视频号图书 CPS</p>
        </div>

        <!-- 卡片 3 · AI 电商 -->
        <div class="relative rounded-xl border border-accent-500/40 bg-neutral-900 p-4 hover:border-accent-400 transition group overflow-hidden">
          <div class="absolute top-3 right-3 text-[10px] font-bold text-accent-500 bg-accent-500/10 px-2 py-1 rounded uppercase tracking-wider">每单 30 分钟</div>
          <div class="text-3xl mb-3">🛒</div>
          <div class="text-xs text-accent-400 font-semibold tracking-wider mb-1">AI 电商 · 客服 / 选品</div>
          <h3 class="text-lg font-semibold text-white">每天 200 条消息不加班</h3>
          <p class="mt-3 text-sm text-neutral-400 leading-relaxed">
            <strong class="text-white">之前</strong>：每天回复 200 条相似问题，2 小时翻消息。
          </p>
          <p class="mt-2 text-sm text-neutral-400 leading-relaxed">
            <strong class="text-accent-400">用 CLI</strong>：CLI 调智能体，10 分钟排查常见问题 + 5 分钟优化话术。
          </p>
          <p class="mt-3 text-sm font-semibold text-orange-400">→ 收入：店铺销售额 + 复购</p>
        </div>
      </div>

      <!-- 底部双 CTA -->
      <div class="mt-5 flex flex-col sm:flex-row gap-4 items-center justify-center">
        <Button href="https://aipoju.com/cli" variant="primary" size="md" external>
          立即体验破局 CLI →
        </Button>
        <Button href="/recommend/paiju/" variant="secondary" size="md">
          看 7 篇圈友 CLI 复盘 →
        </Button>
      </div>
    </div>
  </section>

  <!-- 04 Selected Content -->
  <section id="content" class="bg-neutral-900/50 border-y border-neutral-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <SectionLabel number="04" title="Selected Content" />
      <p class="text-neutral-500 -mt-6 mb-5 text-sm">
        聚合自「{SITE.wechatOAName}」与本站长文
      </p>
      <div class="grid md:grid-cols-3 gap-3">
        {articles.map((a) => <ArticleCard {...a} />)}
      </div>
      <div class="mt-5 text-center">
        <a href="/blog/" class="text-accent-400 hover:underline">更多文章 →</a>
      </div>
    </div>
  </section>

  <!-- 05 Featured Projects -->
  <section id="projects" class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <SectionLabel number="05" title="Featured Projects" />
    <div class="grid md:grid-cols-3 gap-3">
      {projects.map((p) => <ProjectCard {...p} />)}
    </div>
    <div class="mt-5 text-center">
      <a href="/projects/" class="text-accent-400 hover:underline">所有作品 →</a>
    </div>
  </section>

  <!-- 06 Tools -->
  <section id="tools" class="bg-neutral-900/50 border-y border-neutral-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <SectionLabel number="06" title="Tools · 一站式工具集" />
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {tools.map((t) => <ToolCard {...t} />)}
      </div>
      <div class="mt-5 text-center">
        <a href="/tools/" class="text-accent-400 hover:underline">所有工具 →</a>
      </div>
    </div>
  </section>

  <!-- 07 About -->
  <section id="about" class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <SectionLabel number="07" title="About" />
    <div class="flex items-start gap-3 max-w-3xl">
      <div
        class="w-20 h-20 rounded-full bg-gradient-to-br from-accent-400 to-orange-500 flex-shrink-0 flex items-center justify-center text-2xl text-neutral-950 font-bold shadow-lg shadow-accent-500/30"
      >
        东
      </div>
      <div>
        <h3 class="text-xl font-semibold text-white">你好，我是 东歌AI</h3>
        <p class="mt-3 text-neutral-300 leading-relaxed">
          <strong class="text-accent-400">AI 副业实战派</strong>，帮普通人用 AI 写公众号、做带货、搭电商平台。
        </p>
        <p class="mt-3 text-sm text-neutral-400">
          📧{' '}
          <a
            href={`mailto:${SITE.email}`}
            class="text-accent-400 hover:underline"
          >
            {SITE.email}
          </a>
          {' '}· 💬 微信公众号「{SITE.wechatOAName}」 · 🌐{' '}
          <a href="/rss.xml" class="text-accent-400 hover:underline">RSS</a>
          {' '}·{' '}
          <a href="/about/" class="text-accent-400 hover:underline">
            完整介绍 →
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- 08 Community -->
  <section id="community" class="bg-neutral-900/50 border-y border-neutral-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <SectionLabel number="08" title="Community · 社群" />
      <div class="grid md:grid-cols-3 gap-3">
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="text-xs text-neutral-500 mb-2 uppercase tracking-wider">微信公众号</div>
          <div class="font-semibold text-lg text-white">{SITE.wechatOAName}</div>
          <p class="mt-3 text-sm text-neutral-400">
            每周更新 AI 工具实战、电商案例与方法论
          </p>
          <div class="mt-4 aspect-square bg-neutral-800 rounded-lg flex items-center justify-center text-neutral-500 text-sm border border-dashed border-neutral-700">
            <div class="text-center px-4">
              <div class="text-3xl mb-2">📱</div>
              <div>微信二维码</div>
              <div class="text-xs mt-1 text-neutral-600">
                图片就位后将显示在此
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-accent-500/30 bg-neutral-900 p-4">
          <div class="text-xs text-accent-400 mb-2 uppercase tracking-wider">AI 破局 Skill 商城</div>
          <div class="font-semibold text-lg text-white">aipoju.com/skill-store</div>
          <p class="mt-3 text-sm text-neutral-400">
            破局官方技能商城 · 模板、智能体、工作流，一键复用
          </p>
          <a
            href="https://aipoju.com/skill-store"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1 px-4 py-2 bg-accent-500 text-neutral-950 rounded-lg text-sm font-medium hover:bg-accent-400 transition"
          >
            立即逛逛 →
          </a>
        </div>

        <div class="rounded-xl border border-accent-500/30 bg-neutral-900 p-4">
          <div class="text-xs text-accent-400 mb-2 uppercase tracking-wider">AI 破局 CLI</div>
          <div class="font-semibold text-lg text-white">aipoju.com/cli</div>
          <p class="mt-3 text-sm text-neutral-400">
            命令行工具 · 接入破局生态，技能/智能体一唤即用
          </p>
          <a
            href="https://aipoju.com/cli"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1 px-4 py-2 bg-accent-500 text-neutral-950 rounded-lg text-sm font-medium hover:bg-accent-400 transition"
          >
            立即体验 →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 Contact 已合并到 07 About（删除） -->
</BaseLayout>
