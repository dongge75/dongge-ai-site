---
/*
  /recommend/paiju · 完全复刻 whenreset.dev/scys 的设计系统
  内容是"我推荐 AI 破局俱乐部"，不假冒品牌
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="我推荐 AI 破局俱乐部 · 东歌1"
  description="来自东歌1 的真实推荐。AI 时代，先学先赢。"
  standalone={true}
>
  <style is:global>
    /* ============================================================
       全局 - 完全复刻 whenreset.dev/scys 的设计 token
       ============================================================ */
    body {
      color: #173f35;
      background: #f7f8f1;
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
      font-size: 15px;
      line-height: 1.75;
    }
    .site * { box-sizing: border-box; }
    .site a { color: inherit; text-decoration: none; }
    .site h1, .site h2, .site h3, .site p { margin: 0; }
    .site h1, .site h2, .site h3 {
      letter-spacing: -0.045em;
      color: inherit;
      font-family: inherit;
    }
    .site h2 { font-size: 36px; font-weight: 650; line-height: 1.35; }
    .site h3 { font-size: 20px; font-weight: 650; line-height: 1.5; }
    .site p { color: #65716a; }
  </style>

  <style>
    /* ============================================================
       工具类 - 复刻原站点的视觉细节
       ============================================================ */
    .eyebrow {
      letter-spacing: 0.12em;
      color: #007e6c;
      align-items: center;
      gap: 8px;
      margin-bottom: 22px;
      font-size: 11px;
      font-weight: 650;
      display: flex;
    }
    .eyebrow > span {
      background: #00a282;
      border-radius: 50%;
      width: 7px;
      height: 7px;
      display: inline-block;
    }

    .primary {
      background: #007e6c;
      color: #fff;
      border-radius: 4px;
      justify-content: center;
      align-items: center;
      gap: 12px;
      min-height: 48px;
      padding: 12px 22px;
      font-size: 14px;
      font-weight: 600;
      line-height: 1.5;
      transition: background 0.15s;
      display: inline-flex;
    }
    .primary:hover { background: #005e50; }

    .textLink {
      border-bottom: 1px solid #8ca99b;
      align-items: center;
      gap: 6px;
      padding-bottom: 3px;
      font-size: 13px;
      font-weight: 600;
      display: inline-flex;
    }

    /* ============================================================
       HEADER - 导航
       ============================================================ */
    .siteHeader {
      border-bottom: 1px solid #dce2d6;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      max-width: 1232px;
      min-height: 100px;
      margin: 0 auto;
      padding: 23px 40px;
      display: flex;
    }
    .brand {
      letter-spacing: -0.03em;
      align-items: center;
      gap: 12px;
      font-size: 20px;
      font-weight: 650;
      display: flex;
    }
    .brandMark {
      color: #fff;
      background: #007e6c;
      border-radius: 50%;
      place-items: center;
      width: 42px;
      height: 42px;
      font-size: 26px;
      font-weight: 600;
      display: grid;
    }
    .brand small {
      letter-spacing: 0.18em;
      color: #65716a;
      font-size: 10px;
      font-weight: 450;
      display: block;
    }
    .headerNav {
      align-items: center;
      gap: 30px;
      font-size: 13px;
      display: flex;
    }
    .navCta {
      border: 1px solid #aac4b5;
      border-radius: 4px;
      padding: 9px 15px;
      font-weight: 600;
      color: #173f35;
    }

    /* ============================================================
       MAIN - 内容容器
       ============================================================ */
    .siteMain {
      max-width: 1232px;
      margin: 0 auto;
      padding: 0 40px;
    }

    /* ============================================================
       HERO - 头部双列
       ============================================================ */
    .hero {
      grid-template-columns: 1.25fr 1fr;
      align-items: center;
      gap: 64px;
      padding: 83px 0 86px;
      display: grid;
    }
    .heroLead {
      font-size: 16px;
      line-height: 1.9;
      color: #65716a;
    }
    .heroNote {
      color: #778278;
      margin-top: 24px;
      font-size: 11px;
    }

    /* 英雄 - 体验卡视觉（复刻 og:image 主视觉）*/
    .heroTrialCard {
      position: relative;
      width: 100%;
      aspect-ratio: 1.45 / 1;
      max-width: 480px;
      margin: 0 auto;
      border-radius: 14px;
      padding: 24px;
      background:
        radial-gradient(ellipse at top right, rgba(255,255,255,0.7) 0%, transparent 65%),
        radial-gradient(ellipse at center, #5fd8c4 0%, #36bfa9 55%, #1ea190 100%);
      box-shadow:
        0 30px 60px -20px rgba(0, 126, 108, 0.5),
        0 0 0 1px rgba(255,255,255,0.4) inset;
      color: #0a3d35;
      transform: rotate(-2deg);
      overflow: hidden;
    }
    .trialCardTop {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: rgba(255,255,255,0.85);
      margin-bottom: 18px;
    }
    .trialCardDays {
      font-size: 56px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.04em;
      color: #0a3d35;
    }
    .trialCardDays small {
      font-size: 22px;
      font-weight: 500;
      color: rgba(10,61,53,0.7);
      margin-left: 6px;
      letter-spacing: 0;
    }
    .trialCardLabel {
      font-size: 64px;
      font-weight: 800;
      line-height: 1;
      letter-spacing: -0.05em;
      color: #0a3d35;
      margin: 28px 0 14px;
    }
    .trialCardSub {
      font-size: 18px;
      font-weight: 500;
      color: rgba(10,61,53,0.78);
      border-top: 2px solid rgba(10,61,53,0.5);
      padding-top: 16px;
      max-width: 80%;
    }
    .trialCardMark {
      position: absolute;
      bottom: -60px;
      right: -30px;
      font-size: 280px;
      font-weight: 800;
      color: rgba(255,255,255,0.18);
      line-height: 1;
      pointer-events: none;
      user-select: none;
    }

    /* ============================================================
       SECTIONS - 通用段（v2.1 东哥要求 5 板块上下空白 1/3）
       ============================================================ */
    .section {
      padding: 27px 0;
      border-top: 1px solid #dce2d6;
    }
    .sectionHead {
      margin-bottom: 16px;
      max-width: 720px;
    }
    .section#cases .sectionHead {
      margin-bottom: 8px;
    }
    .sectionHead p {
      margin-top: 10px;
      font-size: 15px;
      line-height: 1.75;
    }

    /* ============================================================
       BENEFITS - 权益卡片
       ============================================================ */
    .benefitGrid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }
    .benefitCard {
      background: #fbfcf6;
      border: 1px solid #dce2d6;
      border-radius: 10px;
      padding: 28px;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .benefitCard:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px #007e6c1a;
    }
    .benefitIcon {
      width: 44px;
      height: 44px;
      color: #007e6c;
      background: #d9eee0;
      border-radius: 12px;
      place-items: center;
      margin-bottom: 18px;
      display: grid;
      font-size: 22px;
    }
    .benefitLabel {
      letter-spacing: 0.12em;
      color: #007e6c;
      font-size: 11px;
      font-weight: 650;
      margin-bottom: 6px;
    }
    .benefitCard h3 {
      color: #173f35;
      margin-bottom: 8px;
    }
    .benefitCard p {
      font-size: 14px;
      line-height: 1.7;
    }

    /* ============================================================
       JOIN - 加入区 (v2.1 改为 3 列横放: 个人介绍 + 个人二维 + 群二维码)
       ============================================================ */
    .joinGrid3 {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 16px;
      align-items: stretch;
    }
    .joinHint {
      color: #65716a;
      font-size: 14px;
      line-height: 1.75;
      margin-bottom: 12px;
    }
    .qrCard {
      background: #fff;
      border: 1px solid #dce2d6;
      border-radius: 14px;
      padding: 24px;
      text-align: center;
      box-shadow: 0 16px 48px -20px rgba(23,63,53,0.18);
    }
    .qrCardImg {
      width: 100%;
      max-width: 200px;
      aspect-ratio: 1 / 1;
      margin: 0 auto 12px;
      display: block;
      border-radius: 8px;
    }
    .qrCardLabel {
      color: #007e6c;
      font-size: 12px;
      font-weight: 650;
      letter-spacing: 0.12em;
      margin-bottom: 4px;
    }
    .qrCardNote {
      color: #65716a;
      font-size: 13px;
      line-height: 1.7;
    }

    /* 移动端扫码长按提示 - 复刻陈木木踩坑修复版 */
    .mobileHint {
      margin-top: 16px;
      padding: 12px;
      background: #fbf3c8;
      border: 1px solid #e8d97e;
      border-radius: 8px;
      color: #7a5c00;
      font-size: 12px;
      line-height: 1.7;
    }
    .mobileHint strong { color: #5e4500; }

    /* ============================================================
       CASES - 案例
       ============================================================ */
    .caseGrid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }
    .caseCard {
      background: #fbfcf6;
      border: 1px solid #dce2d6;
      border-radius: 10px;
      padding: 24px;
      display: flex;
      flex-direction: column;
    }
    .caseCardTop {
      color: #65716a;
      font-size: 11px;
      font-weight: 650;
      letter-spacing: 0.12em;
      margin-bottom: 18px;
    }
    .caseCardMetric {
      font-size: 30px;
      font-weight: 700;
      color: #007e6c;
      letter-spacing: -0.03em;
      line-height: 1.2;
      margin-bottom: 10px;
    }
    .caseCardBody {
      color: #173f35;
      font-size: 14px;
      line-height: 1.7;
      flex: 1;
    }
    .caseByline {
      color: #65716a;
      font-size: 11px;
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid #dce2d6;
    }

    /* ============================================================
       CASES LIST - 10 条案例列表（仿生财 list 风格）
       ============================================================ */
    .caseList {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .caseListItem {
      display: grid;
      grid-template-columns: 32px 40px 1fr 90px 110px;
      align-items: center;
      gap: 14px;
      padding: 2px 16px;
      background: #fbfcf6;
      border: 1px solid #dce2d6;
      border-radius: 8px;
      transition: all 0.18s ease;
    }
    .caseListItem:hover {
      border-color: #007e6c;
      background: #fff;
      transform: translateX(2px);
      box-shadow: 0 4px 16px rgba(0, 126, 108, 0.08);
    }
    .caseListNum {
      font-size: 15px;
      font-weight: 700;
      color: #007e6c;
      letter-spacing: -0.02em;
      text-align: center;
    }
    .caseListAvatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      color: #fff;
      font-weight: 700;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }
    .caseListMain {
      min-width: 0;
    }
    .caseListTitle {
      font-size: 13.5px;
      font-weight: 600;
      color: #173f35;
      line-height: 1.4;
      margin-bottom: 2px;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .caseListType {
      font-size: 9px;
      font-weight: 650;
      letter-spacing: 0.1em;
      padding: 1px 6px;
      border-radius: 3px;
      background: #d9eee0;
      color: #007e6c;
    }
    .caseListMeta {
      font-size: 10.5px;
      color: #65716a;
      margin-bottom: 2px;
    }
    .caseListDesc {
      font-size: 11.5px;
      color: #65716a;
      line-height: 1.5;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
    }
    .caseListMetric {
      text-align: center;
    }
    .caseListNumBig {
      font-size: 17px;
      font-weight: 700;
      color: #007e6c;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
    .caseListLabel {
      font-size: 9px;
      color: #65716a;
      letter-spacing: 0.08em;
      margin-top: 1px;
    }
    .caseListRight {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
    }
    .caseListTags {
      display: flex;
      gap: 3px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .caseListTag {
      font-size: 9px;
      padding: 1px 6px;
      background: #f4f6ef;
      color: #65716a;
      border-radius: 8px;
      border: 1px solid #dce2d6;
    }
    .caseListCta {
      font-size: 11px;
      color: #007e6c;
      text-decoration: none;
      font-weight: 600;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
    .caseListCta:hover { text-decoration: underline; }

    .caseDisclaimer {
      margin-top: 32px;
      padding: 16px;
      color: #65716a;
      font-size: 11px;
      line-height: 1.7;
      border-left: 3px solid #dce2d6;
    }

    /* ============================================================
       FOOTER
       ============================================================ */
    .siteFooter {
      border-top: 1px solid #dce2d6;
      padding: 32px 40px;
      max-width: 1232px;
      margin: 0 auto;
      color: #65716a;
      font-size: 11px;
      letter-spacing: 0.04em;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    .siteFooter a { color: #007e6c; }

    /* ============================================================
       响应式
       ============================================================ */
    @media (max-width: 768px) {
      .siteHeader { padding: 16px 20px; min-height: 64px; }
      .siteMain { padding: 0 20px; }
      .hero {
        grid-template-columns: 1fr;
        padding: 48px 0;
        gap: 40px;
      }
      .heroTrialCard {
        max-width: 100%;
        aspect-ratio: 1.4 / 1;
        transform: rotate(-1deg);
      }
      .trialCardLabel { font-size: 48px; }
      .trialCardDays { font-size: 44px; }
      .trialCardMark { font-size: 180px; bottom: -40px; right: -20px; }
      .section { padding: 19px 0; }
      .joinGrid { grid-template-columns: 1fr; }
      .joinGrid3 { grid-template-columns: 1fr; }
      .qrCardImg { width: 100%; max-width: 220px; }
      .siteFooter { padding: 24px 20px; flex-direction: column; align-items: flex-start; }
      .caseListItem {
        grid-template-columns: 28px 36px 1fr;
        grid-template-rows: auto auto;
        gap: 4px 10px;
        padding: 2px 12px;
      }
      .caseListMetric {
        grid-column: 2 / 4;
        grid-row: 2;
        text-align: left;
        display: flex;
        align-items: baseline;
        gap: 4px;
      }
      .caseListNumBig { font-size: 13px; }
      .caseListLabel { font-size: 9px; }
      .caseListRight {
        grid-column: 3 / 4;
        grid-row: 2;
        align-items: flex-end;
      }
      .caseListAvatar { width: 32px; height: 32px; font-size: 13px; }
      .caseListTitle { font-size: 13px; }
      .caseListDesc { -webkit-line-clamp: 2; }
    }

    /* ============================================================
       精华帖卡新结构（陈木木 8 字段）
       ============================================================ */
    .caseCardMeta {
      font-size: 13px;
      color: #65716a;
      margin-top: -8px;
      margin-bottom: 16px;
      font-weight: 500;
    }
    .caseCardSection {
      margin-bottom: 14px;
      padding-bottom: 14px;
      border-bottom: 1px dashed #e2e7e0;
    }
    .caseCardSection:last-of-type {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
    .caseCardLabel {
      font-size: 12px;
      font-weight: 700;
      color: #007e6c;
      margin-bottom: 8px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .caseCardText {
      font-size: 14px;
      color: #3a443d;
      line-height: 1.7;
    }
    .caseCardText em {
      color: #65716a;
      font-style: italic;
    }
    .caseCardList {
      margin: 0;
      padding-left: 22px;
      font-size: 14px;
      color: #3a443d;
      line-height: 1.8;
    }
    .caseCardList li {
      margin-bottom: 4px;
    }
    .caseCardList li::marker {
      color: #007e6c;
      font-weight: 700;
    }
    .caseCardHint {
      margin-top: 10px;
      padding: 10px 14px;
      background: #f0f7f4;
      border-radius: 6px;
      font-size: 13px;
      color: #3a443d;
      line-height: 1.7;
    }
    .caseCardQuote {
      margin: 6px 0;
      padding: 8px 14px;
      background: #fbfcf6;
      border-left: 3px solid #007e6c;
      font-size: 14px;
      font-style: italic;
      color: #1c2820;
      line-height: 1.6;
    }
    .caseCardFooter {
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px solid #e2e7e0;
      font-size: 12px;
      color: #65716a;
      line-height: 1.8;
    }
    .caseCardPaywall {
      margin-top: 8px;
      padding: 10px 14px;
      background: #fff8e1;
      border-left: 3px solid #f0a000;
      color: #5a4a2a;
      border-radius: 4px;
    }

    /* ============================================================
       体验卡 CARD（v2.1 东哥要求 2 张图横放）
       ============================================================ */
    .cardSplit {
      display: flex;
      flex-direction: row;
      gap: 12px;
      max-width: 960px;
      margin: 0 auto 16px;
      align-items: stretch;
    }
    .cardPart {
      display: block;
      width: 100%;
      border-radius: 12px;
      border: 1px solid #dce2d6;
      overflow: hidden;
      box-shadow: 0 4px 12px rgba(0, 30, 25, 0.06);
    }
    .cardPart-top {
      aspect-ratio: 100 / 70;
      object-fit: cover;
      object-position: top center;
    }
    .cardPart-bottom {
      aspect-ratio: 100 / 35;
      object-fit: cover;
      object-position: bottom center;
    }
    .cardTip {
      max-width: 640px;
      margin: 0 auto;
      padding: 16px 20px;
      background: #fbfcf6;
      border: 1px solid #dce2d6;
      border-left: 4px solid #007e6c;
      border-radius: 10px;
      font-size: 15px;
      line-height: 1.7;
      color: #3a443d;
    }
    .cardTip strong {
      color: #007e6c;
      margin-right: 4px;
    }

    /* ============================================================
       体验交流群 COMMUNITY (v2.1 整个板块删除, 内容并入 JOIN)
       ============================================================ */

    @media (max-width: 768px) {
      .cardSplit { flex-direction: row; gap: 8px; }
      .cardPart-top { aspect-ratio: 100 / 70; }
      .cardPart-bottom { aspect-ratio: 100 / 35; }
    }
  </style>

  <div class="site">

    <!-- ============================================ -->
    <!-- HEADER                                       -->
    <!-- ============================================ -->
    <header class="siteHeader">
      <div class="brand">
        <div class="brandMark">东</div>
        <div>
          <div>东歌AI</div>
          <small>DONG GE AI · 个人推荐</small>
        </div>
      </div>
      <nav class="headerNav">
        <a href="#hero">推荐</a>
        <a href="#cases">案例</a>
        <a href="#card">领卡</a>
        <a href="#join">加入</a>
        <a href="https://donggeai.com" class="navCta">主站 →</a>
      </nav>
    </header>

    <main class="siteMain">

      <!-- ============================================ -->
      <!-- HERO · 主视觉（复刻 og:image 体验卡）         -->
      <!-- ============================================ -->
      <section id="hero" class="hero">
        <div>
          <div class="eyebrow">
            <span></span>
            本周推荐 · 个人真实使用 / 第 ④ 期
          </div>
          <h1 style="font-size: clamp(38px, 4.3vw, 59px); font-weight: 650; line-height: 1.24; margin-bottom: 25px;">
            拥抱 AI，<br />
            <span style="color: #007e6c;">用出先机。</span>
          </h1>
          <p class="heroLead">
            51 岁，<strong>审计人</strong>。最近 <strong>1 年</strong>我把 AI 用进 <strong>公众号、视频号图书带货、AI 电商全链路创作</strong>三个方向。
            其中对我帮助最大的社群，是 <strong>AI 破局俱乐部</strong>——知识星球活跃榜常驻 TOP1，累计 58,000+ 付费圈友。
            <br /><br />
            这一页是我挂的官方推荐入口——通过我扫码进去，俱乐部会知道是「东歌1」带来的。
            现在扫码领 <strong>7 天免费体验 + 3 天新手实操课</strong>。
          </p>
