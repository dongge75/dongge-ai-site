---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="页面不存在" description="404 Not Found">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12 text-center">
    <div class="text-7xl font-bold bg-gradient-to-r from-accent-400 to-orange-400 bg-clip-text text-transparent">
      404
    </div>
    <h1 class="mt-3 text-3xl font-semibold text-white">页面不存在</h1>
    <p class="mt-2 text-neutral-400">
      您访问的页面可能已被移动、改名或从未存在。
    </p>
    <div class="mt-5 flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button href="/" variant="primary" size="md">
        回到首页 →
      </Button>
      <Button href="/blog/" variant="secondary" size="md">
        去博客看看
      </Button>
    </div>
  </section>
</BaseLayout>
