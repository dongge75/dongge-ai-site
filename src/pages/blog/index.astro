---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const posts = [
  {
    title: '从 0 到 1：搭建个人一站式平台',
    desc: '花了三天时间，踩了这些坑——域名、托管、备案、Astro 选型，把公众号、视频号、自研工具统一到一个入口',
    date: '2026-10-12',
    source: '博客',
    href: '/blog/',
  },
  {
    title: '用 AI 重构客服工作流',
    desc: '从每天回复 200 条消息到解放双手',
    date: '2026-10-08',
    source: '公众号',
    href: '/blog/',
  },
  {
    title: 'OPC 创业者必备的 5 个 AI 工具',
    desc: '一个人 = 一家公司，这些工具让你事半功倍',
    date: '2026-09-25',
    source: '公众号',
    href: '/blog/',
  },
];
---

<BaseLayout title="博客" description="长文、随笔与思考">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-white">Blog · 博客</h1>
      <p class="mt-4 text-lg text-neutral-400">长文、随笔与思考</p>
    </header>

    <div class="space-y-4">
      {posts.map((p) => <ArticleCard {...p} />)}
    </div>

    <div class="mt-12 rounded-xl border border-dashed border-neutral-800 bg-neutral-900/30 p-6 text-center">
      <p class="text-sm text-neutral-500">
        📝 更多文章在公众号「东哥副业笔记」持续更新 · 本站稍后接入 RSSHub 自动同步
      </p>
    </div>
  </section>
</BaseLayout>
